generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------
// Core Models
// ----------------------------------------------------------------------

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  // Roles: Admin | CEO | COO | Team Lead | Sales Executive | Designer | Employee
  role               String    @default("Employee")
  googleId           String?   @unique
  refreshToken       String?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee            Employee?
  givenSpiffs         Spiff[]            @relation("SpiffGiver")
  auditLogs           AuditLog[]
  notifications       Notification[]
  approvedOverrides   PayslipOverride[]  @relation("OverrideApprover")
  reviewedPayouts     DesignerPayoutRequest[] @relation("PayoutReviewer")
}

model CompanyProfile {
  id        String   @id @default(uuid())
  name      String
  address   String?
  logoUrl   String?
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id                  String               @id @default(uuid())
  name                String               @unique
  description         String?
  status              String               @default("active") // active, inactive, archived
  startDate           DateTime?
  endDate             DateTime?
  monthlyShowupTarget Int                  @default(0)
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Relations
  members             CampaignMember[]
  commissionStructures CommissionStructure[]
  performances        CampaignPerformance[]
}

model Employee {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  
  employeeCode     String    @unique
  fullName         String
  designation      String
  managerId        String?
  manager          Employee?   @relation("EmployeeToManager", fields: [managerId], references: [id])
  subordinates     Employee[]  @relation("EmployeeToManager")
  
  status           String      @default("active") // active, on_leave, terminated, resigned
  baseSalary       Float       @default(0) // Stored in PKR
  currency         String      @default("PKR")
  phone            String?
  birthday         String?
  bankAccount      String?
  emergencyContact String?
  photoUrl         String?
  
  shiftStart       String      @default("18:00") // Standard shift start: 6:00 PM
  shiftEnd         String      @default("23:59") // Standard shift end
  graceMinutes     Int         @default(15)      // Legacy: grace period in minutes
  // Per-employee custom late threshold override (minutes after shiftStart)
  // Standard: 15 min (18:15). For Adeen: 45 (18:45). null = use system default
  customLateThresholdMinutes Int?
  // Artists/Designers are exempt from daily shift clock-in rules and use monthly salary cycle
  attendanceExempt Boolean     @default(false)
  // Fast flag: true for Designers on monthly salary cycle (5th settlement)
  isArtist         Boolean     @default(false)
  zkUserId         String?     @unique
  
  commissionPercentage Float    @default(0)
  department           String?  @default("Operations")
  joiningDate          DateTime? @default(now())

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  salaryHistory        SalaryHistory[]
  campaignMembers      CampaignMember[]
  performances         CampaignPerformance[]
  spiffs               Spiff[]              @relation("EmployeeSpiff")
  attendance           Attendance[]
  leaveRequests        LeaveRequest[]
  halfdayRequests      HalfdayRequest[]
  wfhRequests          WfhRequest[]
  loanRequests         LoanRequest[]
  payslips             Payslip[]
  documents            Document[]
  sales                Sale[]               @relation("SalesExecutiveSales")
  designedProjects     Sale[]               @relation("DesignerProjects")
  salaryPayments       SalaryPayment[]
  payoutRequests       DesignerPayoutRequest[]
  credentialVault      CredentialVault[]
  artistAdvances       ArtistAdvance[]
}

// ----------------------------------------------------------------------
// System Settings & Configuration
// ----------------------------------------------------------------------

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// ----------------------------------------------------------------------
// Sales, Projects, Briefs & Payments
// ----------------------------------------------------------------------

model Sale {
  id                   String            @id @default(uuid())
  projectNumber        String            @unique // e.g. PRJ-1024
  clientName           String
  clientEmail          String?
  projectName          String
  saleDate             DateTime          @default(now())
  employeeId           String            // Sales Executive ID
  employee             Employee          @relation("SalesExecutiveSales", fields: [employeeId], references: [id], onDelete: Cascade)
  
  designerId           String?           // Assigned Designer ID
  designer             Employee?         @relation("DesignerProjects", fields: [designerId], references: [id], onDelete: SetNull)
  
  saleAmount           Float             // USD Gross Sale
  upfrontAmount        Float             @default(0) // USD Upfront Paid
  tipAmount            Float             @default(0) // USD Tip Amount
  designerFee          Float             @default(0) // USD
  amountPaidToDesigner Float             @default(0) // USD
  salesCommissionUsd   Float             @default(0) // USD
  
  projectStage         String            @default("Initial Sketch") // Initial Sketch, Line Art, Base Color, Final Artwork
  stageUpdatedAt       DateTime          @default(now())
  briefStatus          String            @default("Pending") // Pending, Uploaded, Resolved
  paymentStatus        String            @default("Unpaid") // Unpaid, Partial, Paid
  
  amountReceived       Float             @default(0) // USD Net/Gross Received
  remainingAmount      Float             @default(0) // USD
  installmentsCount    Int               @default(1)
  installmentsReceived Int               @default(0)
  nextPaymentDate      DateTime?
  
  platform             String?           @default("Direct / Website") // Outreach Platform e.g. Upwork, Fiverr, LinkedIn, Instagram, Email
  paymentMethod        String?           @default("Online/Bank Transfer") // Online/Bank Transfer, Wise, Stripe, PayPal, Crypto
  completionDate       DateTime?
  fallInMonth          String?           // e.g. "Sep 2026", "2026-09"
  workDetails          String?           // Work description / specifications
  extraInfo            String?           // Notes / Extra Info
  notes                String?

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  briefs               ProjectBrief[]
  stageLogs            ProjectStageLog[]
  payments             SalePayment[]
  payoutRequests       DesignerPayoutRequest[]
  floatEntries         FloatLedger[]
  assetUploads         ProjectAssetUpload[]
  overrides            SaleOverride[]
}

model ProjectBrief {
  id           String   @id @default(uuid())
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  uploadedById String
  designerId   String?  // Target Artist assigned to this brief
  fileName     String
  fileUrl      String   // Data URL or file URL (png, jpeg, webp, pdf, docx)
  fileType     String   @default("png")
  version      Int      @default(1)
  notes        String?
  status       String   @default("Pending") // Pending | In Progress | Feedback | Approved
  artistUpdate String?  // Updates/notes put by the Artist
  updatedAt    DateTime @updatedAt @default(now())
  createdAt    DateTime @default(now())
}

model ProjectStageLog {
  id            String   @id @default(uuid())
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  updatedById   String
  previousStage String
  newStage      String
  notes         String?
  createdAt     DateTime @default(now())
}

model SalePayment {
  id                String   @id @default(uuid())
  saleId            String
  sale              Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  installmentNumber Int      @default(1)
  dueDate           DateTime?
  paymentDate       DateTime @default(now())
  
  grossAmount       Float    // USD sent by client e.g. $200
  feeDeducted       Float    @default(0) // USD bank/tax fee e.g. $10
  netAmount         Float    // USD net in bank e.g. $190
  amount            Float    // Legacy field (alias to netAmount)
  
  exchangeRate      Float?   // USD -> PKR rate e.g. 278.5
  pkrAmount         Float?   // PKR received
  paymentMethod     String   @default("Online/Bank Transfer")
  status            String   @default("received") // received | pending | delayed
  fallInMonth       String?  // e.g. "Sep 2026"
  verifiedByCeo     Boolean  @default(false)
  ceoNotes          String?
  notes             String?
  createdAt         DateTime @default(now())
}

// ----------------------------------------------------------------------
// Sales Override — CEO & Team Lead official reconciled layer
// ----------------------------------------------------------------------

model SaleOverride {
  id                     String   @id @default(uuid())
  saleId                 String
  sale                   Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  verifiedSaleAmount     Float?
  verifiedUpfront        Float?
  verifiedRemaining      Float?
  verifiedNetReceivedUsd Float?
  totalFeesDeductedUsd   Float?
  verifiedPkrReceived    Float?
  overrideNotes          String?
  updatedById            String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// ----------------------------------------------------------------------
// Finance, Expenses & Salary Payouts
// ----------------------------------------------------------------------

model Expense {
  id            String   @id @default(uuid())
  category      String   // Office Expenses, Office Rent, Utilities, Software/Subscriptions, Equipment, Miscellaneous
  description   String
  amount        Float
  date          DateTime @default(now())
  paymentMethod String   @default("Online/Bank Transfer")
  notes         String?
  createdById   String
  createdAt     DateTime @default(now())
}

model SalaryPayment {
  id               String   @id @default(uuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payslipId        String?
  periodMonth      Int
  periodYear       Int
  basicSalary      Float
  commissionAmount Float    @default(0)
  bonuses          Float    @default(0)
  deductions       Float    @default(0)
  netSalary        Float
  amountPaid       Float    @default(0)
  remainingAmount  Float    @default(0)
  paymentDate      DateTime @default(now())
  paymentMethod    String   @default("Online/Bank Transfer")
  status           String   @default("Pending") // Fully Paid, Partial, Pending
  notes            String?
  createdAt        DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())
}

model Document {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  name         String
  type         String   // contract, id, medical, receipt...
  fileUrl      String   // link to Supabase Storage
  uploadedById String
  createdAt    DateTime @default(now())
}

// ----------------------------------------------------------------------
// Compensation & History
// ----------------------------------------------------------------------

model SalaryHistory {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  oldSalary     Float?
  newSalary     Float
  reason        String?
  effectiveDate DateTime
  createdById   String?
  createdAt     DateTime @default(now())
}

model CampaignMember {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       String   // team_lead, sdr
  status     String   @default("active") // active, inactive
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, employeeId])
}

model CommissionStructure {
  id         String           @id @default(uuid())
  campaignId String
  campaign   Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  status     String           @default("draft") // active, draft, archived
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  slabs      CommissionSlab[]
}

model CommissionSlab {
  id          String              @id @default(uuid())
  structureId String
  structure   CommissionStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  minShowups  Int
  maxShowups  Int?                // Null represents infinity (e.g. 31+)
  rate        Float
  type        String              @default("per_showup") // per_showup, fixed_monthly, percentage, hybrid
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model CampaignPerformance {
  id                String   @id @default(uuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  campaignId        String
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  month             Int      // 1-12
  year              Int      // e.g. 2026
  meetingsBooked    Int      @default(0)
  showups           Int      @default(0)
  noShows           Int      @default(0)
  cancelledMeetings Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([employeeId, campaignId, month, year])
}

model Spiff {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation("EmployeeSpiff", fields: [employeeId], references: [id])
  givenById  String
  givenBy    User     @relation("SpiffGiver", fields: [givenById], references: [id])
  amount     Float
  reason     String?
  date       DateTime @default(now())
}

// ----------------------------------------------------------------------
// Attendance & Leave
// ----------------------------------------------------------------------

model Attendance {
  id             String   @id @default(uuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  date           DateTime @db.Date
  status         String   // present, absent, half_day, leave, holiday, weekend
  checkIn        DateTime?
  checkOut       DateTime?
  late           Int      @default(0) // minutes late
  earlyDeparture Int      @default(0) // minutes early
  overtime       Int      @default(0) // minutes overtime
  note           String?
  zkSyncId       String?  // reference to ZKTeco log

  @@unique([employeeId, date])
}

model AttendanceLog {
  id        String   @id @default(uuid())
  zkUserId  String
  timestamp DateTime
  type      String   // check-in, check-out
  syncedAt  DateTime @default(now())
}

model LeaveRequest {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  type         String   // annual, sick, unpaid...
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  days         Float
  reason       String?
  status       String   @default("pending") // pending, approved, rejected
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
}

model HalfdayRequest {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  date         DateTime @db.Date
  reason       String?
  status       String   @default("pending")
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
}

model WfhRequest {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  reason       String?
  status       String   @default("pending")
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
}

// ----------------------------------------------------------------------
// Payroll & Loans
// ----------------------------------------------------------------------

model LoanRequest {
  id               String   @id @default(uuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  type             String   // loan, advance_salary
  amount           Float
  reason           String?
  status           String   @default("pending")
  repaymentMonth   Int?
  repaymentYear    Int?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
}

model PayrollRun {
  id          String    @id @default(uuid())
  periodMonth Int
  periodYear  Int
  status      String    @default("draft") // draft, finalized
  createdById String?
  createdAt   DateTime  @default(now())
  finalizedAt DateTime?
  
  payslips    Payslip[]

  @@unique([periodMonth, periodYear])
}

model Payslip {
  id                   String     @id @default(uuid())
  payrollRunId         String
  payrollRun           PayrollRun @relation(fields: [payrollRunId], references: [id])
  employeeId           String
  employee             Employee   @relation(fields: [employeeId], references: [id])
  
  baseSalary           Float      // PKR
  daysPresent          Float      @default(0)
  daysInPeriod         Int        @default(0)

  // Attendance-driven deduction tracking
  lateMarksCount       Int        @default(0)   // raw late count for the month
  lateAbsenceEquivalents Int      @default(0)   // floor(lateMarksCount / 2)
  
  unpaidLeaveDeduction Float      @default(0) // PKR
  lateDeduction        Float      @default(0) // PKR — from 2-lates=1-absence rule
  loansDeduction       Float      @default(0) // PKR
  otherDeductions      Float      @default(0) // PKR

  // CEO override net adjustment (without altering original time logs)
  overrideAdjustment   Float      @default(0) // PKR — positive=bonus, negative=extra deduction
  
  bonus                Float      @default(0) // PKR
  commission           Float      @default(0) // PKR (legacy field)
  commissionUsd        Float      @default(0) // USD
  commissionPkr        Float      @default(0) // PKR
  exchangeRateUsed     Float      @default(280) // USD -> PKR exchange rate at finalization
  spiffs               Float      @default(0) // PKR
  attendanceAllowance  Float      @default(0) // PKR
  punctualityAllowance Float      @default(0) // PKR
  
  netPay               Float      // PKR
  
  showups              Int        @default(0)
  meetingsScheduled    Int        @default(0)
  noShows              Int        @default(0)
  
  pdfUrl               String?    // link to Supabase Storage
  generatedAt          DateTime   @default(now())

  overrides            PayslipOverride[]

  @@unique([payrollRunId, employeeId])
}

// ----------------------------------------------------------------------
// System & Logs
// ----------------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   // system, leave, payroll, loan, payout_request, sla_alert, float_alert
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------
// Designer Payout Requests (Artist → CEO approval workflow)
// ----------------------------------------------------------------------

model DesignerPayoutRequest {
  id           String    @id @default(uuid())
  saleId       String
  sale         Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  designerId   String
  designer     Employee  @relation(fields: [designerId], references: [id], onDelete: Cascade)
  amount       Float     // USD amount requested
  reason       String?
  // Status: pending | approved | rejected | paid
  status       String    @default("pending")
  reviewedById String?
  reviewedBy   User?     @relation("PayoutReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  ceoNote      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ----------------------------------------------------------------------
// Float Ledger — Tracks early artist payouts vs delayed client installments
// ----------------------------------------------------------------------

model FloatLedger {
  id           String   @id @default(uuid())
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // type: artist_payout_advance | client_installment_received | float_reconcile | manual_adjustment
  type         String
  amount       Float    // USD — positive = money in, negative = money out
  description  String?
  runningFloat Float    @default(0) // Snapshot of float balance after this entry
  createdById  String
  createdAt    DateTime @default(now())
}

// ----------------------------------------------------------------------
// Payslip CEO Overrides — Adjust net pay without altering time logs
// ----------------------------------------------------------------------

model PayslipOverride {
  id             String   @id @default(uuid())
  payslipId      String
  payslip        Payslip  @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  // overrideType: waive_late_deduction | waive_absence_deduction | custom_bonus | custom_deduction
  overrideType   String
  originalAmount Float    // PKR — the original computed deduction/bonus
  overrideAmount Float    // PKR — the new amount (0 to waive entirely)
  reason         String
  approvedById   String
  approvedBy     User     @relation("OverrideApprover", fields: [approvedById], references: [id])
  createdAt      DateTime @default(now())
}

// ----------------------------------------------------------------------
// Credential Vault — Sales Executive outreach account management
// ----------------------------------------------------------------------

model CredentialVault {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  platform      String   // e.g. LinkedIn, HubSpot, Apollo, Instantly, Gmail
  label         String   // e.g. Primary Account, Backup Account 1
  username      String?
  // Password stored as a hint/partial mask — NOT plain text
  passwordHint  String?
  url           String?
  accountType   String   @default("primary") // primary | backup | shared
  isActive      Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ----------------------------------------------------------------------
// Artist Salary Cycle — Monthly advances & 5th-of-month settlement
// ----------------------------------------------------------------------

model ArtistAdvance {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month        Int      // 1–12
  year         Int
  amount       Float    // PKR — mid-month draw entered by CEO
  note         String?  // e.g. "Emergency draw", "Project completion bonus"
  enteredById  String   // CEO/Admin user ID who logged this
  createdAt    DateTime @default(now())

  @@index([employeeId, month, year])
}

// ----------------------------------------------------------------------
// Project Asset Uploads — Designer-submitted completed artwork
// ----------------------------------------------------------------------

model ProjectAssetUpload {
  id           String   @id @default(uuid())
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  uploadedById String   // Designer's user ID
  designerId   String   // Designer's employee ID
  fileName     String
  fileUrl      String   // Supabase Storage URL
  // fileType: png | jpeg | jpg | pdf
  fileType     String
  stage        String   // Which project stage this asset belongs to
  notes        String?
  createdAt    DateTime @default(now())

  @@index([saleId])
  @@index([designerId])
}
