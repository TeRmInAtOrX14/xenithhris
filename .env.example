# ArtXenith HRIS - Environment Configuration Example

# Database Connection (Supabase PostgreSQL / Direct URL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?schema=public"

# Supabase Auth & Client API Parameters
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Supabase Service Role Key (SERVER SIDE ONLY — NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# JWT Secret & Application Config
JWT_SECRET="your_strong_jwt_secret_token"
PORT=4000
FRONTEND_URL="https://hris.artxenith.com"
COMPANY_NAME="ArtXenith"
